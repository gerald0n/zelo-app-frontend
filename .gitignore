!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*:Zone.Identifier

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example


# Evolution API — sessão/credenciais se usar bind mount local
/evolution-data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

certificates

# AI agent skills (instaladas via `npx skills` / `impeccable` — não são código do projeto)
/.claude/skills/
/.agents/skills/
/.impeccable/
# skills-lock.json fica versionado: é só o manifesto para reinstalar as skills
