# Painel administrativo — copie para `.env.local` e preencha.
# Após `pnpm db:start` (na raiz), confira URL/chaves com `pnpm db:status`.

# --- Públicas (NEXT_PUBLIC_*) ---

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alternativa (projetos novos): NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=local

# Cloudflare Turnstile — obrigatório em production (login admin).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Chave pública VAPID (push de mudança de status do pedido para o cliente).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Opcional. Origin do cardápio, só pro link de acompanhamento na mensagem do
# botão "Avisar no WhatsApp". Default: https://cardapio.zeloconfeitaria.com.br
NEXT_PUBLIC_CLIENT_APP_ORIGIN=

# --- Privadas — somente servidor ---

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Push web (o painel dispara ao mudar o status do pedido).
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@zelo.local

TURNSTILE_SECRET_KEY=

SENTRY_DSN=
# Só no ambiente de BUILD (Vercel). org/project fixos no next.config.ts
# (zelo-confeitaria / zelo-admin).
SENTRY_AUTH_TOKEN=

# Invalidação on-demand do cache do catálogo no app do cliente, após editar
# catálogo/loja no painel. Os dois precisam estar setados; senão a propagação
# cai no TTL do cache (~60 s).
#   CATALOG_REVALIDATE_SECRET: mesmo valor do `apps/client` (openssl rand -hex 32)
#   CLIENT_APP_ORIGIN: origin do cardápio, ex. https://cardapio.zeloconfeitaria.com.br
CATALOG_REVALIDATE_SECRET=
CLIENT_APP_ORIGIN=

APP_ENV=local
