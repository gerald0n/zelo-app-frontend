# Ambiente local — copie para `.env.local` e preencha.
# Após `pnpm db:start`, confira URL/chaves com `pnpm db:status`.

# --- Públicas (NEXT_PUBLIC_*) ---

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alternativa (projetos novos): NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Gere o par com: pnpm exec web-push generate-vapid-keys
# Mapa interativo no checkout usa Leaflet + OpenStreetMap (sem chave).
# Opcional — Geocoding + Distance Matrix no servidor (restrinja por IP / API).
# Sem essa chave, a rota é calculada via OpenStreetMap/OSRM.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=local

# Cloudflare Turnstile — obrigatório em production (OTP e login admin).
# Local/preview sem chaves: honeypot + rate limit por IP ainda valem.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# IP Wi‑Fi do Windows para acesso LAN (opcional; pnpm dev:lan detecta sozinho)
# DEV_LAN_HOST=192.168.0.5

# --- Privadas — somente servidor ---

# URL interna do servidor (WSL). Em LAN, mantenha 127.0.0.1;
# o browser usa NEXT_PUBLIC_SUPABASE_URL (pnpm dev:lan aponta ao IP Wi‑Fi).
SUPABASE_URL=http://127.0.0.1:54321

SUPABASE_SERVICE_ROLE_KEY=

# Geocoding + Distance Matrix (restrinja por IP / API).
GOOGLE_MAPS_API_KEY=

# Twilio Verify — obrigatório em production para OTP do cliente por SMS.
# Em local/preview, sem SID/token o código aparece na tela de verificação.
# TWILIO_VERIFY_SMS_SERVICE_SID é opcional se o serviço de SMS for outro VA...
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_SMS_SERVICE_SID=

VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@zelo.local

SENTRY_DSN=
SENTRY_AUTH_TOKEN=

TURNSTILE_SECRET_KEY=

APP_ENV=local
